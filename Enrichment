OlinkID <- PD_vs_HC_serum_long_v1 %>% 
          select(OlinkID, Assay) %>%
          distinct(OlinkID, .keep_all = TRUE)

test_results <- PD_vs_HC_LM_results_df %>% 
                rename(Assay = "assay", Adjusted_pval = "adjusted_p_value") %>%
                left_join(OlinkID, by = "Assay")

gsea_results <- olink_pathway_enrichment(data = PD_vs_HC_serum_long_v1, test_results = test_results, organism = "human", ontology = "MSigDb")

ora_results_GO <- olink_pathway_enrichment(
  data = PD_vs_HC_serum_long_v1,
  test_results = test_results, method = "ORA", ontology = "GO")

ora_results_KEGG <- olink_pathway_enrichment(
  data = PD_vs_HC_serum_long_v1,
  test_results = test_results, method = "ORA", ontology = "KEGG")



olink_pathway_heatmap(enrich_results = gsea_results, test_results = test_results)

olink_pathway_heatmap(enrich_results = ora_results_GO, test_results = test_results,
                      method = "ORA", number_of_terms = 10)

olink_pathway_heatmap(enrich_results = ora_results_KEGG, test_results = test_results,
